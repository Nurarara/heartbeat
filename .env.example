# Local setup: npm run ai:prepare creates an ignored .dev.vars safely.
# Edit .dev.vars locally. Never paste the Cloudflare token into the browser/chat.
HEARTBEAT_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_WORKERS_AI_TOKEN
HEARTBEAT_AI_ACCESS_KEY=GENERATED_BY_LOCAL_SETUP
HEARTBEAT_APP_ORIGIN=http://localhost:5173
HEARTBEAT_AI_DAILY_LIMIT=3
HEARTBEAT_DIRECTOR_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
HEARTBEAT_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
HEARTBEAT_APP_MODE=development
HEARTBEAT_BILLING_ENABLED=false
# Production: set APP_MODE=production, HTTPS APP_ORIGIN, verified email delivery and Stripe test configuration first.
HEARTBEAT_EMAIL_API_KEY=
HEARTBEAT_EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STUDIO_PRICE_ID=
STRIPE_ATELIER_PRICE_ID=

# Optional operator study only on HTTP loopback; never enable on staging/production.
HEARTBEAT_LEGACY_ROUTES_ENABLED=false
# Do not trust proxy headers on an exposed origin. Hosted release enables it behind Cloudflare.
HEARTBEAT_TRUST_CLOUDFLARE_IP=false
# Hosted staging/production require commercial weather configuration. No purchase is automatic.
HEARTBEAT_WEATHER_PROVIDER=open-meteo-free
HEARTBEAT_WEATHER_API_KEY=
HEARTBEAT_WEATHER_ATTRIBUTION=Weather by Open-Meteo
# Monetary estimates in USD micro-units (1,000,000 = $1); approval/measurement required before hosting.
HEARTBEAT_DAILY_BUDGET_MICROS=0
HEARTBEAT_DIRECTOR_ESTIMATE_MICROS=0
HEARTBEAT_IMAGE_ESTIMATE_MICROS=0
HEARTBEAT_PROVIDER_CONCURRENCY=2
# Separate operator credential, never a browser/customer key. Disabled when empty.
HEARTBEAT_OPERATOR_KEY=
